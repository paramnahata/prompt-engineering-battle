# --- Supabase (server-only secret + server-only URL) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key   # NEVER exposed to the browser
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# --- Same values, exposed to the browser ONLY for Realtime subscriptions ---
# (RLS denies anon direct table access by default — see supabase/migrations/0002_rls.sql)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# --- Gemini (server-only) ---
GEMINI_API_KEY=your-gemini-api-key

# --- App secrets ---
EVENT_SECRET=change-me-long-random-string      # derives the rotating access code
SESSION_SECRET=change-me-another-long-random-string  # signs session cookies

# --- Optional: protects the cron route from public invocation ---
CRON_SECRET=change-me-cron-secret
