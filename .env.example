# Prompt Engineering Battle — environment variables
# Copy to .env.local for local development (never commit .env / .env.local),
# and set the same names in Vercel → Project → Settings → Environment Variables.
# Everything is server-only. Do NOT prefix any of these with NEXT_PUBLIC_.

# ---------------------------------------------------------------- required
# Supabase project URL and the service-role / secret key (server only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Signs session cookies, derives the key that encrypts the admin-saved Gemini
# key, and (unless PIN_PEPPER is set) the rotating 60-second team PINs.
# At least 32 random characters. Changing it signs everyone out, changes all
# team PINs and makes a key saved in Admin → AI Judging unreadable (re-enter it).
SESSION_SECRET=change-me-at-least-32-random-characters

# ---------------------------------------------------------------- optional
# Separate secret for the rotating team PINs (32+ characters). If unset,
# SESSION_SECRET is used.
PIN_PEPPER=

# Gemini key from the environment instead of Admin → AI Judging.
GEMINI_API_KEY=
# Primary model and comma-separated fallbacks used when a model's daily quota
# runs out ("none" disables fallbacks). Free tier: pick models with a high
# requests-per-day limit (check aistudio.google.com/rate-limit).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Requests per minute the evaluator sends (default 8). Keep it just under your
# project's per-minute limit; raise it with a billing-enabled key.
GEMINI_RPM=14

# Enables /api/cron/process-evaluations for a scheduled worker (Vercel Cron
# sends "Authorization: Bearer $CRON_SECRET"). If unset the route is disabled;
# "Run evaluation" in the admin dashboard still works.
CRON_SECRET=

# ---------------------------------------------------------------- no longer used
# EVENT_SECRET (room code was removed), GEMINI_CONCURRENCY,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_PUBLISHABLE_KEY can be removed.
