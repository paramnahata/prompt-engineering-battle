# ---------------------------------------------------------------------------
# Server-only. None of these may be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase (service role / secret key — server only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Signs session cookies AND derives the key that encrypts the admin-saved
# Gemini key. At least 32 random characters. Changing it signs everyone out
# and makes a key saved in Admin → AI Judging unreadable (re-enter it).
SESSION_SECRET=change-me-at-least-32-random-characters

# Derives the rotating 4-digit event access code.
EVENT_SECRET=change-me-long-random-string

# Optional: Gemini key from the environment instead of Admin → AI Judging.
GEMINI_API_KEY=
# Optional: model id (default gemini-2.5-flash) and parallel evaluations (default 4, max 8).
GEMINI_MODEL=
GEMINI_CONCURRENCY=

# Optional: enables /api/cron/process-evaluations for a scheduled worker
# (Vercel Cron sends "Authorization: Bearer $CRON_SECRET"). If unset the
# route is disabled; the admin dashboard's "Run evaluation" still works.
CRON_SECRET=

# The browser no longer talks to Supabase directly, so
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY /
# SUPABASE_PUBLISHABLE_KEY are no longer used and can be removed.
